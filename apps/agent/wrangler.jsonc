{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openengage-agent",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "ai": {
    "binding": "AI",
  },
  "browser": {
    "binding": "BROWSER",
  },
  // Workers Traces shows each agent response as a trace with agent-level
  // spans: https://flueframework.com/docs/guide/observability/#cloudflare
  "observability": { "traces": { "enabled": true } },
  // Every agent generates a Durable Object class named after its identity
  // (Hello -> FlueHelloAgent), and Cloudflare requires a migration entry
  // for each one. Append a new tag when you add an agent:
  // https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FlueHelloAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["FlueAutomationDesignerAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["FlueEmailDesignerAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["FlueSegmentDesignerAgent"] },
    { "tag": "v5", "new_sqlite_classes": ["FlueEmailSequenceDesignerAgent"] },
    { "tag": "v6", "new_sqlite_classes": ["FlueMarketingAutomationDesignerAgent"] },
    { "tag": "v7", "new_sqlite_classes": ["FlueCompanyEnrichmentAgent"] },
    { "tag": "v8", "new_sqlite_classes": ["FlueLandingPageDesignerAgent"] },
  ],
  "env": {
    "bootstrap": {
      "name": "openengage-agent",
      "services": [],
      "ai": {
        "binding": "AI",
      },
      "browser": {
        "binding": "BROWSER",
      },
    },
  },
}
