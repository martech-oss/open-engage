{
  "name": "@openengage/agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "vite build && wrangler deploy",
    "deploy:bootstrap": "CLOUDFLARE_ENV=bootstrap vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check:types": "pnpm typecheck",
    "cf:types": "wrangler types worker-configuration.d.ts --env-interface AgentBindings --config wrangler.jsonc"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.5",
    "@flue/runtime": "^2.0.1",
    "@openengage/core": "workspace:*",
    "agents": "^0.14.2",
    "hono": "catalog:",
    "just-bash": "^3.2.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@flue/cli": "^2.0.1",
    "@flue/vite": "^2.0.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.14",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
