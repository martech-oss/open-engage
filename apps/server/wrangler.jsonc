{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openengage-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "services": [
    {
      "binding": "AGENT_APP",
      "service": "openengage-agent",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openengage-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "openengage-assets",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["notifications@example.com"],
    },
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS_QUEUE", "queue": "openengage-jobs" },
      { "binding": "DELIVERY_QUEUE", "queue": "openengage-delivery" },
    ],
    "consumers": [
      {
        "queue": "openengage-jobs",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "openengage-dead-letter",
      },
      {
        "queue": "openengage-delivery",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "openengage-dead-letter",
      },
      {
        "queue": "openengage-dead-letter",
        "max_batch_size": 50,
        "max_batch_timeout": 10,
      },
      {
        "queue": "openengage-email-events",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "openengage-dead-letter",
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *"],
  },
  "vars": {
    "APP_NAME": "OpenEngage",
    "APP_URL": "http://localhost:5173",
    "ENVIRONMENT": "development",
    "TRANSACTIONAL_FROM_EMAIL": "notifications@example.com",
    "TRANSACTIONAL_FROM_NAME": "OpenEngage",
    "REPLY_DOMAIN": "reply.example.com",
    "RAW_EVENT_RETENTION_DAYS": "90",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
