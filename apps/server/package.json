{
  "name": "@openengage/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "email:dev": "email dev --dir src/auth/email-templates",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run && node --test scripts/public-form-runtime.check.mjs",
    "cf:types": "wrangler types --env-interface ServerBindings --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply openengage-db --local --persist-to ../client/.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply openengage-db --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@flue/sdk": "2.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openengage/core": "workspace:*",
    "@openengage/database": "workspace:*",
    "@openengage/orpc": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "css-tree": "^3.2.1",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "postal-mime": "^2.7.5",
    "react": "catalog:",
    "react-email": "^6.9.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@react-email/ui": "^6.9.2",
    "@types/css-tree": "^3.2.0",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
