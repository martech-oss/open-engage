{
  "name": "@openengage/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "email:dev": "email dev --dir src/auth/email-templates",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/check-no-raw-sql.mjs",
    "cf:types": "wrangler types --env-interface ServerBindings",
    "db:migrate:local": "wrangler d1 migrations apply openengage-db --local --persist-to ../client/.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply openengage-db --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@flue/sdk": "2.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openengage/core": "workspace:*",
    "@openengage/database": "workspace:*",
    "@openengage/orpc": "workspace:*",
    "@orpc/openapi": "1.14.13",
    "@orpc/server": "^1.14.13",
    "@orpc/zod": "1.14.13",
    "better-auth": "^1.6.25",
    "css-tree": "^3.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "postal-mime": "^2.7.5",
    "react": "^19.1.1",
    "react-email": "^6.9.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@orpc/client": "1.14.13",
    "@orpc/contract": "1.14.13",
    "@react-email/ui": "^6.9.2",
    "@types/css-tree": "^3.2.0",
    "@types/react": "^19.1.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.114.0"
  }
}
