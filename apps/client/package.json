{
  "name": "@openengage/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build --config vite.verify.config.ts && node ../../scripts/check-client-bundles.mjs && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "cf:types": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --config wrangler.jsonc --config ../server/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:preview",
    "dev:preview": "vite --config preview/vite.config.ts",
    "test:preview": "vitest run --config preview/vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@openengage/core": "workspace:*",
    "@openengage/orpc": "workspace:*",
    "@orpc/client": "^1.14.13",
    "@orpc/contract": "^1.14.13",
    "@orpc/tanstack-query": "1.14.13",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^7.0.6",
    "vitest": "catalog:",
    "wrangler": "^4.115.0"
  }
}
