{
  "name": "openengage-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-native open source marketing automation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm architecture:check && pnpm typecheck && pnpm test && pnpm build",
    "architecture:test": "node --test scripts/check-architecture.test.mjs",
    "architecture:check": "pnpm architecture:test && node scripts/check-architecture.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "dev": "pnpm db:migrate:local && pnpm --parallel --filter @openengage/client --filter @openengage/agent dev",
    "dev:client": "pnpm --filter @openengage/client dev",
    "deploy": "pnpm --filter @openengage/server deploy && pnpm --filter @openengage/agent deploy && pnpm --filter @openengage/client deploy",
    "typecheck": "pnpm cf:types && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test --passWithNoTests",
    "cf:types": "pnpm --filter @openengage/server cf:types && pnpm --filter @openengage/agent cf:types && pnpm --filter @openengage/client cf:types",
    "db:generate": "pnpm --filter @openengage/database db:generate",
    "db:migrate:local": "pnpm --filter @openengage/server db:migrate:local",
    "db:migrate:remote": "pnpm --filter @openengage/server db:migrate:remote"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
