{
  "name": "openengage-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-native open source marketing automation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run //#format:check //#lint //#architecture:check //#quality:unused typecheck test build",
    "architecture:test": "node --test scripts/check-architecture.test.mjs",
    "architecture:check": "pnpm architecture:test && node scripts/check-architecture.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "quality:unused": "knip --no-progress --no-config-hints --no-tag-hints",
    "dev": "turbo run dev --filter=@openengage/client --filter=@openengage/agent",
    "dev:client": "turbo run dev --filter=@openengage/client",
    "deploy": "pnpm --filter @openengage/server deploy && pnpm --filter @openengage/agent deploy && pnpm --filter @openengage/client deploy",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "cf:types": "turbo run cf:types",
    "db:generate": "turbo run db:generate --filter=@openengage/database",
    "db:migrate:local": "turbo run db:migrate:local --filter=@openengage/server",
    "db:migrate:remote": "turbo run db:migrate:remote --filter=@openengage/server"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "knip": "^6.32.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "2.10.11",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
